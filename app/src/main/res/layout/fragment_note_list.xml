<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/notesRootContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvNotesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="@string/notes_title"
            android:textAppearance="?attr/textAppearanceNotivoDisplay"
            app:layout_constraintEnd_toStartOf="@id/btnFolders"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnFolders"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_toolbar_ripple"
            android:contentDescription="@string/action_folders"
            app:layout_constraintBottom_toBottomOf="@id/tvNotesTitle"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintTop_toTopOf="@id/tvNotesTitle"
            app:srcCompat="@drawable/ic_folder"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_toolbar_ripple"
            android:contentDescription="@string/action_settings"
            app:layout_constraintBottom_toBottomOf="@id/tvNotesTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvNotesTitle"
            app:srcCompat="@drawable/ic_settings"
            app:tint="?attr/colorOnSurface" />

        <!-- Persistent Pill Search Bar -->
        <LinearLayout
            android:id="@+id/searchBarContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNotesTitle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_search"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/etSearchNotes"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_notes_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_toolbar_ripple"
                android:contentDescription="@string/action_clear_search"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Category / Folder Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/chipsScrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/searchBarContainer">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="96dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipsScrollView" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyNotesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipsScrollView"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/ivEmptyNotesIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_notes"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvEmptyNotesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/notes_empty_title"
                android:textAppearance="?attr/textAppearanceNotivoTitleMedium" />

            <TextView
                android:id="@+id/tvEmptyNotesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/notes_empty_subtitle"
                android:textAppearance="?attr/textAppearanceNotivoSubtitleLight"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyCreateNote"
                style="@style/Widget.Notivo.PrimaryPillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                android:text="@string/notes_empty_cta" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.lumatech.notivo.ui.common.ExpandableFabView
        android:id="@+id/expandableFabNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
