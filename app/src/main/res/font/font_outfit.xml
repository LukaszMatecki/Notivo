<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="o">
    <font
        android:font="@font/outfit_light"
        android:fontStyle="normal"
        android:fontWeight="300"
        app:font="@font/outfit_light"
        app:fontStyle="normal"
        app:fontWeight="300" />
    <font
        android:font="@font/outfit_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/outfit_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/outfit_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/outfit_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/outfit_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/outfit_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/outfit_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/outfit_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
    <font
        android:font="@font/outfit_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800"
        app:font="@font/outfit_extrabold"
        app:fontStyle="normal"
        app:fontWeight="800" />
</font-family>
